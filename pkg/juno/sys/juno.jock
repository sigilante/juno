// sys/juno — an Arvo in Jock.
//
// Arvo is an event processor whose outer interface is four arms
// at four fixed axes: +load/+4, +wish/+10, +peek/+22, +poke/+23.
// A Jock kernel built by jock's own tools/kern.sh already lands
// its arms on exactly those axes, so this is a port of Arvo's
// SEMANTICS onto an ABI that was already Arvo-shaped.  See
// README.md for what that does and does not buy.
//
// What is here: the move loop, with Arvo's duct discipline
// (%pass pushes a wire, %give pops one), its worklist stack,
// its depth-first ordering, its %$ pseudo-vane for the runtime
// boundary, and two vanes to drive all of it.
//
// The four arms are an `impl Kernel<lull.Ovum>` rather than an
// explicit quad.  The quad was not a choice:  the kernel trait used
// to fix poke's return to (List<Effect>, Self), and an Arvo gives
// OVUMS, so naming the trait was impossible and the raw tuple was
// the only way out.  The trait is parameterized over its effect
// vocabulary now, so the escape hatch is gone and the kernel says
// what it answers with.
//
// The loop rides as METHODS of the same class, not as free funcs,
// and that is forced rather than chosen:  a func cannot name a
// class declared after it (%elab-unbound) and a class arm cannot
// call a func declared after IT (only adjacent funcs see each
// other), so a class-based kernel whose loop is free functions
// cannot be written in either order.  As methods it reads better
// anyway --- `self` IS the kernel, so threading the state is
// dispatch rather than a parameter.
//
// What is deliberately not here: +wish (it IS the Hoon compiler),
// %veer-style runtime vane installation (a vane is code, not a
// vase), kelvin negotiation, and OTA.  README.md says which of
// those are impossible and which are merely unbuilt.
import lull;
import dill;
import echo;

// Arvo's persistent state is [pit vil lac eny our bud vanes].
// .pit and .vil are a compiled-type cache and .bud is %zuse:
// all three exist to serve the vase layer, and all three are
// gone.  What is left is the part that was never about types.
//
// The vane states sit here directly.  An earlier draft held them
// in a separate struct so that threading one vane's state did not
// mean respelling every scalar field -- which was a workaround
// for a limitation Jock does not have.  A `var` rebinding plus a
// field write is a Nock edit at that field's axis, so the loop
// below threads the whole kernel and writes one field of it.
struct St { now: @, our: @, eny: @, lac: @, d: dill.St, e: echo.St };

// the event the runtime hands +23.  Arvo's sample is
// [now=@da ovo=ovum] with ovum=[wire card] and card=[mark noun],
// which flattens to this four-field mirror.
struct Event { now: @, wire: lull.Wire, mark: @, data: * };

class Juno(St) impl Kernel<lull.Ovum> {

// +vcall: route a task to a vane, replacing that vane's state.
// Arvo looks the vane up in a (map term vane) and +slaps it;
// here the table is a static dispatch, because a vane is code.
//
// The Mien is built per call and handed down.  A vane gets it and
// its own state, and hands back only its own state -- so a vane
// cannot reach or write the kernel's, exactly as in Arvo.
  vcall(self: Juno, way: @, duct: lull.Duct, task: lull.Card)
    -> (List<lull.Move>, Juno) {
  let m = lull.Mien( our: self.our, now: self.now, eny: self.eny );
  if way == %d {
    match dill.call(self.d, m, duct, task) {
      (mz, d2) => { var t = self; t.d = d2; (mz, t) },
    }
  } else if way == %e {
    match echo.call(self.e, m, duct, task) {
      (mz, e2) => { var t = self; t.e = e2; (mz, t) },
    }
  } else {
    // Arvo routes way=%$ to +call:pith, its own %trim/%verb/%whey
    // self-tasks.  juno has no self-tasks yet.
    crash
  }
};

// +vtake: hand a vane a response on the wire it passed.
  vtake(self: Juno, way: @, duct: lull.Duct, wire: lull.Wire,
           sign: lull.Sign) -> (List<lull.Move>, Juno) {
  let m = lull.Mien( our: self.our, now: self.now, eny: self.eny );
  if way == %d {
    match dill.take(self.d, m, duct, wire, sign) {
      (mz, d2) => { var t = self; t.d = d2; (mz, t) },
    }
  } else if way == %e {
    match echo.take(self.e, m, duct, wire, sign) {
      (mz, e2) => { var t = self; t.e = e2; (mz, t) },
    }
  } else {
    crash
  }
};

// +step: route one move.  This is Arvo's +step arm, case for case.
  step(self: Juno, src: @, mv: lull.Move, run: List<lull.Plan>,
          out: List<lull.Ovum>) -> (List<lull.Ovum>, Juno) {
  match mv.ball {
    // %pass: cons the SOURCE onto the wire, and the wire onto the
    // duct.  That is the whole of Arvo's causal bookkeeping.
    .pass(p) => {
      let d2 = cons(cons(src, p.wire), mv.duct);
      match self.vcall(p.note.vane, d2, p.note.task) {
        (mz, k2) =>
          k2.drain(cons(lull.Plan( vane: p.note.vane, moves: mz ), run), out),
      }
    },
    // %slip: lateral.  The duct is NOT touched, so the callee's
    // eventual %give returns to the original caller rather than to
    // the slipping vane.  Arvo's own comment calls this a code
    // smell that should nearly always be avoided; it is here
    // because the loop is not faithful without it.
    .slip(n) => match self.vcall(n.vane, mv.duct, n.task) {
      (mz, k2) =>
        k2.drain(cons(lull.Plan( vane: n.vane, moves: mz ), run), out),
    },
    // %give: pop the duct.  The popped wire's HEAD names the
    // target and its TAIL is the wire handed back to that target.
    .give(g) => match mv.duct {
      ~ => crash,
      (w, d2) => match w {
        ~ => crash,
        (way, wr) => if way == lull.outside() {
          // the caller was the runtime.  Arvo asserts the duct is
          // empty here, and the assert is worth keeping: a give to
          // the outside from anywhere but the bottom of the stack
          // means a wire was pushed and never popped.
          match d2 {
            ~ => self.drain(run, cons(lull.Ovum( wire: wr, card: g ), out)),
            _ => crash,
          }
        } else {
          // cons the SOURCE onto the gift to make a sign
          match self.vtake(way, d2, wr, lull.Sign( vane: src, gift: g )) {
            (mz, k2) =>
              k2.drain(cons(lull.Plan( vane: way, moves: mz ), run), out),
          }
        },
      },
    },
  }
};

// +drain: Arvo's +loop.  .run is a stack of worklists and .out
// accumulates reversed, exactly as +abet flops it.
//
// ORDERING.  A step's own moves are pushed on the FRONT of .run,
// so they run before the rest of the current worklist: that is
// depth-first, which is what Arvo does today.  Arvo intends to
// move to breadth-first, which guarantees moves are processed in
// the order they were emitted.  Here that is one word -- append
// instead of cons, in the three +step sites and nowhere else.
  drain(self: Juno, run: List<lull.Plan>, out: List<lull.Ovum>)
    -> (List<lull.Ovum>, Juno) {
  match run {
    ~ => (lx-rev(out), self),
    (p, rest) => match p.moves {
      ~ => self.drain(rest, out),
      (mv, more) =>
        self.step(p.vane, mv,
             cons(lull.Plan( vane: p.vane, moves: more ), rest), out),
    },
  }
};

// ---------------------------------------------------------------
// The three arms Arvo's ABI addresses.  +wish, at +10, is not one
// of them:  it IS the Hoon compiler, so this kernel impls Kernel
// rather than FullKernel and the adapter puts a crash formula
// there.  See README.md for why that is a smaller loss than it
// looks.
// ---------------------------------------------------------------

  // +poke/+23.  Arvo seeds a worklist of one whose germ vane is
  // %$ -- itself -- and whose single move is a %pass built by
  // +gest, then drains to quiescence.
  poke(self: Juno, e: *) -> (List<lull.Ovum>, Juno) {
    let ev = e as! Event;
    // +gest: the ovum's wire HEAD names the target vane and its
    // tail is the wire the vane is called on.
    match ev.wire {
      ~ => crash,
      (way, wr) => {
        // Arvo takes .now from the event before anything runs, so
        // that a vane's Mien carries THIS event's time rather than
        // the previous one's.  (Arvo also reseeds .eny per event,
        // via (shaz (cat 3 eny now)); juno does not, which would
        // matter to a vane that wanted entropy.)
        var k0 = self;
        k0.now = ev.now;
        let m = lull.Move(
          duct: ~,
          ball: lull.Ball.pass(lull.Pass(
                  wire: wr,
                  note: lull.Note( vane: way,
                          task: lull.Card( mark: ev.mark,
                                           data: ev.data )))),
          dud: ~ );
        k0.drain(cons(lull.Plan( vane: lull.outside(),
                                 moves: cons(m, ~) ), ~), ~)
      },
    }
  };

  // +peek/+22.  Arvo's sample is [lyc=gang nom=...] and it threads
  // into each vane's +scry.  This answers only the kernel's own
  // state, which is enough for the harness to observe the loop.
  peek(self: Juno, p: *) -> * {
    let w = p as! List<@>;
    match w {
      ~ => self.now,
      (h, t) => if h == %blits { self.d.blits }
                else if h == %last { self.d.last }
                else if h == %echoes { self.e.echoes }
                else { crash },
    }
  };

  // +load/+4.  Arvo runs +next-soul adapters across six state
  // versions.  A same-shape graft is all a draft needs; a real one
  // wants a versioned state union -- NockApp's own outer-state is
  // the pattern (README.md).
  load(self: Juno, old: *) -> Juno { old as! Juno };
};
Juno( now: 0, our: 0, eny: 0, lac: 0,
      d: dill.St( blits: 0, last: 0 ), e: echo.St( echoes: 0 ) )
